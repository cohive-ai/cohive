// Generated by cohive init: Cohive reminders for opencode.
// Running `cohive init` again overwrites this file; `cohive init --no-hooks` removes it.
//
// On every prompt this runs `cohive hook`, the same command the Claude Code and Codex hooks run. When something
// in Cohive is waiting for you, the reminder is attached to your message for the model (hidden in the chat) and
// shown as a toast. Any failure only means "no reminder": it never blocks or delays the prompt for long.
import { spawn } from "node:child_process"
import { randomBytes } from "node:crypto"

const HOOK: string[] = __COHIVE_HOOK_ARGV__
const TIMEOUT_MS = 5000

// Sessions created in this process that have not sent a prompt yet: their first prompt counts as the session start.
const fresh = new Set<string>()

function runHook(event: string, sessionID: string): Promise<string> {
  return new Promise((resolve) => {
    let out = ""
    let settled = false
    let timer: ReturnType<typeof setTimeout> | undefined
    const finish = (text: string) => {
      if (settled) return
      settled = true
      if (timer) clearTimeout(timer)
      resolve(text)
    }
    try {
      const p = spawn(HOOK[0], HOOK.slice(1), { stdio: ["pipe", "pipe", "ignore"] })
      timer = setTimeout(() => {
        p.kill()
        finish("")
      }, TIMEOUT_MS)
      p.stdout.on("data", (d) => (out += d))
      p.on("close", () => finish(out))
      p.on("error", () => finish(""))
      p.stdin.on("error", () => {})
      p.stdin.end(JSON.stringify({ session_id: sessionID, hook_event_name: event, source: "startup" }))
    } catch {
      finish("")
    }
  })
}

// opencode message part IDs: "prt_" + 6 bytes of time (ascending) + 14 random characters.
function partID(): string {
  const t = BigInt(Date.now()) * 4096n + BigInt(randomBytes(1)[0])
  const b = Buffer.alloc(6)
  for (let i = 0; i < 6; i++) b[i] = Number((t >> BigInt(40 - 8 * i)) & 0xffn)
  return "prt_" + b.toString("hex") + randomBytes(7).toString("hex")
}

export const CohiveReminders = async ({ client }: any) => ({
  event: async ({ event }: any) => {
    const id = event?.type === "session.created" ? event.properties?.info?.id : undefined
    if (typeof id === "string") fresh.add(id)
  },
  "chat.message": async (input: any, output: any) => {
    try {
      const start = fresh.delete(input.sessionID)
      const raw = await runHook(start ? "SessionStart" : "UserPromptSubmit", input.sessionID)
      if (!raw.trim()) return
      const res = JSON.parse(raw)
      const text = res?.hookSpecificOutput?.additionalContext
      if (typeof text === "string" && text !== "") {
        output.parts.push({
          id: partID(),
          sessionID: input.sessionID,
          messageID: output.message.id,
          type: "text",
          text,
          synthetic: true,
        })
      }
      const note = res?.systemMessage
      if (typeof note === "string" && note !== "") {
        client?.tui?.showToast?.({ body: { message: note, variant: "info" } })?.catch?.(() => {})
      }
    } catch {
      // no reminder
    }
  },
})

# Cohive 命令行安装脚本（Windows），由协作服务 {{.Server}} 生成。
# 用法：在 PowerShell 里执行  irm {{.Server}}/install.ps1 | iex
# 只从这台协作服务下载，安装前核对 SHA-256；装到当前用户目录，不需要管理员权限。
# 安装位置默认 %LOCALAPPDATA%\Programs\cohive，可用环境变量 COHIVE_INSTALL_DIR 指定。
& {
  $ErrorActionPreference = 'Stop'
  $server = '{{.Server}}'
{{- if .Missing}}
  throw '{{.Missing}}'
{{- else if not .Windows}}
  throw '这台协作服务没有提供 Windows 的安装包'
{{- else}}
  $version = '{{.Version}}'
  $want = '{{.Windows}}'
  if (-not [Environment]::Is64BitOperatingSystem) { throw '目前只提供 64 位 Windows 的安装包' }
  # 较旧的 Windows PowerShell 默认不启用 TLS 1.2
  [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12

  $dir = if ($env:COHIVE_INSTALL_DIR) { $env:COHIVE_INSTALL_DIR } else { Join-Path $env:LOCALAPPDATA 'Programs\cohive' }
  New-Item -ItemType Directory -Force -Path $dir | Out-Null
  $tmp = Join-Path $dir 'cohive.exe.download'
  Write-Host "正在从 $server 下载 cohive $version（windows-amd64）……"
  Invoke-WebRequest -UseBasicParsing -Uri "$server/dl/cohive/windows-amd64" -OutFile $tmp
  $got = (Get-FileHash -Algorithm SHA256 -Path $tmp).Hash.ToLower()
  if ($got -ne $want) {
    Remove-Item -Force $tmp
    throw "校验和不符（期望 $want，实际 $got），已删除下载的文件，没有安装。请重试；仍不符请告诉管理员"
  }
  Move-Item -Force $tmp (Join-Path $dir 'cohive.exe')
  Write-Host "已安装：$dir\cohive.exe"

  $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
  if (-not (($userPath -split ';') -contains $dir)) {
    $newPath = if ($userPath) { "$userPath;$dir" } else { $dir }
    [Environment]::SetEnvironmentVariable('Path', $newPath, 'User')
    $env:Path = "$env:Path;$dir"
    Write-Host "已把 $dir 加入当前用户的 PATH；已经打开的终端和编程工具要重开才能找到 cohive。"
  }
  if ($server.StartsWith('http://') -and -not ($server -match '^http://(localhost|127\.)')) {
    Write-Host '提醒：服务地址是 http://，传输没有加密，只应在内网使用。'
  }
  Write-Host ''
  Write-Host '下一步：配对这台电脑（会打开浏览器，点“授权”即可）'
  Write-Host "  cohive login --server $server"
{{- end}}
}

# Cohive CLI install script (Windows), generated by the Cohive server {{.Server}}.
# Usage: run this in PowerShell:  irm {{.Server}}/install.ps1 | iex
# Downloads only from this server and checks the SHA-256 before installing; installs to the current user's directory and needs no admin rights.
# Installs to %LOCALAPPDATA%\Programs\cohive by default; set the COHIVE_INSTALL_DIR environment variable to choose another directory.
# To pair this computer right after installing: $env:COHIVE_LOGIN=1; irm {{.Server}}/install.ps1 | iex
# Messages come from the server's language pack (internal/i18n/locales/<lang>/install.json); add ?lang=<code> to the URL to pick a language.
& {
  $ErrorActionPreference = 'Stop'
  $server = '{{.Server}}'
{{- if .Missing}}
  throw "{{.Ps "install.no_dist"}}"
{{- else if not .Windows}}
  throw "{{.Ps "install.windows_missing"}}"
{{- else}}
  $version = '{{.Version}}'
  $want = '{{.Windows}}'
  if (-not [Environment]::Is64BitOperatingSystem) { throw "{{.Ps "install.windows_64bit"}}" }
  # Older Windows PowerShell does not enable TLS 1.2 by default
  [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12

  $dir = if ($env:COHIVE_INSTALL_DIR) { $env:COHIVE_INSTALL_DIR } else { Join-Path $env:LOCALAPPDATA 'Programs\cohive' }
  New-Item -ItemType Directory -Force -Path $dir | Out-Null
  $tmp = Join-Path $dir 'cohive.exe.download'
  Write-Host "{{.Ps "install.downloading" "Server" "${server}" "Version" "${version}" "Platform" "windows-amd64"}}"
  Invoke-WebRequest -UseBasicParsing -Uri "$server/dl/cohive/windows-amd64" -OutFile $tmp
  $got = (Get-FileHash -Algorithm SHA256 -Path $tmp).Hash.ToLower()
  if ($got -ne $want) {
    Remove-Item -Force $tmp
    throw "{{.Ps "install.checksum_mismatch" "Want" "${want}" "Got" "${got}"}}"
  }
  Move-Item -Force $tmp (Join-Path $dir 'cohive.exe')
  Write-Host "{{.Ps "install.installed" "Path" "${dir}\\cohive.exe"}}"

  $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
  if (-not (($userPath -split ';') -contains $dir)) {
    $newPath = if ($userPath) { "$userPath;$dir" } else { $dir }
    [Environment]::SetEnvironmentVariable('Path', $newPath, 'User')
    $env:Path = "$env:Path;$dir"
    Write-Host "{{.Ps "install.path_added" "Dir" "${dir}"}}"
  }
  if ($server.StartsWith('http://') -and -not ($server -match '^http://(localhost|127\.)')) {
    Write-Host "{{.Ps "install.http_warning"}}"
  }
  Write-Host ''
  if ($env:COHIVE_LOGIN -eq '1') {
    Write-Host "{{.Ps "install.pairing"}}"
    & (Join-Path $dir 'cohive.exe') login --server $server
  } else {
    Write-Host "{{.Ps "install.next_step"}}"
    Write-Host "  cohive login --server $server"
  }
{{- end}}
}

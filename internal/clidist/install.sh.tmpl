#!/bin/sh
# Cohive CLI install script (macOS, Linux), generated by the Cohive server {{.Server}}.
# Downloads only from this server and checks the SHA-256 before installing; needs no admin rights and does not touch shell config files.
# Installs to ~/.local/bin by default; set COHIVE_INSTALL_DIR to choose another directory.
# To pair this computer right after installing: curl -fsSL {{.Server}}/install.sh | sh -s -- --login (or set COHIVE_LOGIN=1)
# The whole script is wrapped in a function that runs on the last line, so an interrupted download never runs half a script.
# Messages come from the server's language pack (internal/i18n/locales/<lang>/install.json); add ?lang=<code> to the URL to pick a language.
set -eu

cohive_install() {
  server='{{.Server}}'
  dir="${COHIVE_INSTALL_DIR:-$HOME/.local/bin}"

  say() { printf '%s\n' "$*"; }
  fail() { printf '%s\n' "{{.Sh "install.error" "Msg" "$*"}}" >&2; exit 1; }

  login="${COHIVE_LOGIN:-0}"
  for arg in "$@"; do
    case "$arg" in
      --login) login=1 ;;
      *) fail "{{.Sh "install.unknown_arg" "Arg" "${arg}"}}" ;;
    esac
  done
{{- if .Missing}}
  fail "{{.Sh "install.no_dist"}}"
{{- else}}
  version='{{.Version}}'

  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) fail "{{.Sh "install.unsupported_os" "Os" "$(uname -s)" "Server" "${server}"}}" ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=amd64 ;;
    *) fail "{{.Sh "install.unsupported_arch" "Arch" "$(uname -m)"}}" ;;
  esac
  platform="$os-$arch"
  case "$platform" in
{{- range .Files}}
    {{.Platform}}) want='{{.SHA256}}' ;;
{{- end}}
    *) fail "{{.Sh "install.no_platform" "Platform" "${platform}"}}" ;;
  esac

  if command -v curl >/dev/null 2>&1; then
    fetch() { curl -fsSL -o "$2" "$1"; }
  elif command -v wget >/dev/null 2>&1; then
    fetch() { wget -q -O "$2" "$1"; }
  else
    fail "{{.Sh "install.need_fetch"}}"
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    sum() { sha256sum "$1" | awk '{print $1}'; }
  elif command -v shasum >/dev/null 2>&1; then
    sum() { shasum -a 256 "$1" | awk '{print $1}'; }
  else
    fail "{{.Sh "install.need_sum"}}"
  fi

  tmp="$(mktemp -d 2>/dev/null || mktemp -d -t cohive)"
  trap 'rm -rf "$tmp"' EXIT
  trap 'rm -rf "$tmp"; exit 1' INT TERM

  say "{{.Sh "install.downloading" "Server" "${server}" "Version" "${version}" "Platform" "${platform}"}}"
  fetch "$server/dl/cohive/$platform" "$tmp/cohive" || fail "{{.Sh "install.download_failed"}}"
  got="$(sum "$tmp/cohive")"
  if [ "$got" != "$want" ]; then
    fail "{{.Sh "install.checksum_mismatch" "Want" "${want}" "Got" "${got}"}}"
  fi
  chmod 755 "$tmp/cohive"
  mkdir -p "$dir" || fail "{{.Sh "install.mkdir_failed" "Dir" "${dir}"}}"
  # Copy to a temp file in the target directory, then rename: a rename within one directory is atomic, so a running old version is not disturbed
  cp "$tmp/cohive" "$dir/.cohive.new.$$" && mv -f "$dir/.cohive.new.$$" "$dir/cohive" || fail "{{.Sh "install.write_failed" "Path" "${dir}/cohive"}}"

  installed="$("$dir/cohive" version 2>/dev/null || printf 'cohive %s' "$version")"
  say "{{.Sh "install.installed" "Path" "${dir}/cohive"}}"
  say "{{.Sh "install.version" "Version" "${installed}"}}"
  case ":$PATH:" in
    *":$dir:"*) ;;
    *)
      say ""
      say "{{.Sh "install.path_note" "Dir" "${dir}"}}"
      say "{{.Sh "install.path_hint"}}"
      printf '  export PATH="%s:$PATH"\n' "$dir"
      ;;
  esac
  case "$server" in
    http://localhost*|http://127.*|http://\[::1\]*) ;;
    http://*) say ""; say "{{.Sh "install.http_warning"}}" ;;
  esac
  if [ "$login" = 1 ]; then
    # With curl | sh, stdin is the script itself and pairing must read keys from the terminal, so attach /dev/tty
    if (: </dev/tty) 2>/dev/null; then
      say ""
      say "{{.Sh "install.pairing"}}"
      say ""
      "$dir/cohive" login --server "$server" </dev/tty
      return
    fi
    say ""
    say "{{.Sh "install.no_tty"}}"
  fi
  say ""
  say "{{.Sh "install.next_step"}}"
  say "  cohive login --server $server"
{{- end}}
}

cohive_install "$@"

#!/bin/sh
# Cohive 命令行安装脚本（macOS、Linux），由协作服务 {{.Server}} 生成。
# 只从这台协作服务下载，安装前核对 SHA-256；不需要管理员权限，不改 shell 配置文件。
# 安装位置默认 ~/.local/bin，可用 COHIVE_INSTALL_DIR 指定。
# 装完接着配对这台电脑：curl -fsSL {{.Server}}/install.sh | sh -s -- --login（或设 COHIVE_LOGIN=1）
# 整个脚本包在函数里、最后一行才执行：下载中断时不会执行半截脚本。
set -eu

cohive_install() {
  server='{{.Server}}'
  dir="${COHIVE_INSTALL_DIR:-$HOME/.local/bin}"

  fail() { printf '错误：%s\n' "$*" >&2; exit 1; }

  login="${COHIVE_LOGIN:-0}"
  for arg in "$@"; do
    case "$arg" in
      --login) login=1 ;;
      *) fail "不认识的参数 ${arg}（只支持 --login）" ;;
    esac
  done
{{- if .Missing}}
  fail '{{.Missing}}'
{{- else}}
  version='{{.Version}}'

  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) fail "不支持的系统 $(uname -s)：这个脚本支持 macOS 与 Linux；Windows 请在 PowerShell 里执行 irm $server/install.ps1 | iex" ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=amd64 ;;
    *) fail "不支持的处理器架构 $(uname -m)" ;;
  esac
  platform="$os-$arch"
  case "$platform" in
{{- range .Files}}
    {{.Platform}}) want='{{.SHA256}}' ;;
{{- end}}
    *) fail "这台协作服务没有提供 $platform 的安装包" ;;
  esac

  if command -v curl >/dev/null 2>&1; then
    fetch() { curl -fsSL -o "$2" "$1"; }
  elif command -v wget >/dev/null 2>&1; then
    fetch() { wget -q -O "$2" "$1"; }
  else
    fail "需要 curl 或 wget 才能下载"
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    sum() { sha256sum "$1" | awk '{print $1}'; }
  elif command -v shasum >/dev/null 2>&1; then
    sum() { shasum -a 256 "$1" | awk '{print $1}'; }
  else
    fail "需要 sha256sum 或 shasum 来核对校验和"
  fi

  tmp="$(mktemp -d 2>/dev/null || mktemp -d -t cohive)"
  trap 'rm -rf "$tmp"' EXIT
  trap 'rm -rf "$tmp"; exit 1' INT TERM

  printf '正在从 %s 下载 cohive %s（%s）……\n' "$server" "$version" "$platform"
  fetch "$server/dl/cohive/$platform" "$tmp/cohive" || fail "下载失败，请检查网络后重试"
  got="$(sum "$tmp/cohive")"
  if [ "$got" != "$want" ]; then
    fail "校验和不符（期望 ${want}，实际 ${got}），已删除下载的文件，没有安装。请重试；仍不符请告诉管理员"
  fi
  chmod 755 "$tmp/cohive"
  mkdir -p "$dir" || fail "无法创建目录 $dir"
  # 先复制到目标目录里的临时文件再改名：同一目录内改名是原子的，正在运行的旧版不受影响
  cp "$tmp/cohive" "$dir/.cohive.new.$$" && mv -f "$dir/.cohive.new.$$" "$dir/cohive" || fail "无法写入 $dir/cohive"

  printf '已安装：%s/cohive\n版本：%s\n' "$dir" "$("$dir/cohive" version 2>/dev/null || printf 'cohive %s' "$version")"
  case ":$PATH:" in
    *":$dir:"*) ;;
    *)
      printf '\n注意：%s 不在 PATH 里，终端和编程工具会找不到 cohive。\n' "$dir"
      printf '把下面这行加进 shell 配置文件（zsh 是 ~/.zshrc，bash 是 ~/.bashrc），然后重开终端和编程工具：\n'
      printf '  export PATH="%s:$PATH"\n' "$dir"
      ;;
  esac
  case "$server" in
    http://localhost*|http://127.*|http://\[::1\]*) ;;
    http://*) printf '\n提醒：服务地址是 http://，传输没有加密，只应在内网使用。\n' ;;
  esac
  if [ "$login" = 1 ]; then
    # curl | sh 时标准输入是脚本本身，配对要从终端读按键，所以接到 /dev/tty
    if (: </dev/tty) 2>/dev/null; then
      printf '\n接着配对这台电脑（会打开浏览器，点“授权”即可）……\n\n'
      "$dir/cohive" login --server "$server" </dev/tty
      return
    fi
    printf '\n没有可交互的终端，没法接着配对。'
  fi
  printf '\n下一步：配对这台电脑（会打开浏览器，点“授权”即可）\n  cohive login --server %s\n' "$server"
{{- end}}
}

cohive_install "$@"
